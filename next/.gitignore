# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# screenshots written by the verification scripts (verify-ui, verify-app, verify-site,
# verify-contrast, audit-colour, audit-headline). Generated output, ~4MB per run — regenerated
# on demand, never a source of truth.
/shots

# the elevation tiles `scripts/build-terrain.mjs` downloads. Cached so a re-run costs nothing;
# ~2MB of public-domain DEM that is fetched on demand and must not be committed.
/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
