# Copy to .env.local and fill in. NEXT_PUBLIC_* are exposed to the browser (safe: anon key + URL).
# Everything else is server-only and must never be prefixed NEXT_PUBLIC_.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>

# Which social-login buttons to show, comma-separated (google,facebook,apple). Only list a
# provider AFTER you've enabled it in Supabase (Authentication → Providers) — otherwise its
# button appears but errors on click. Leave blank to show no social buttons.
NEXT_PUBLIC_OAUTH_PROVIDERS=

# Server-only
SUPABASE_SERVICE_ROLE_KEY=<service_role key>
SUPABASE_JWT_SECRET=<legacy HS256 secret, or empty if the project uses asymmetric JWKS keys>
SUPABASE_STORAGE_BUCKET=survey-photos

# Postgres (Supabase connection pooler). Same database the .NET app already migrated.
# On serverless hosts (Vercel) use the TRANSACTION pooler: port 6543 (db.ts already sets prepare:false).
DB_HOST=aws-1-ap-northeast-2.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=<db password>

# Long random string; must match the payment provider's webhook secret.
WEBHOOKS_SHARED_SECRET=<random>

# ---- Payments ------------------------------------------------------------------------------
# Which gateway checkout uses: 'ipaymu' or 'midtrans'. Leave unset to prefer iPaymu when it is
# configured and fall back to Midtrans.
PAYMENT_PROVIDER=ipaymu

# iPaymu. Both values come from the merchant dashboard -> Integration -> API Key. Without them
# the checkout and callback routes return 503. NEITHER is safe to prefix with NEXT_PUBLIC_.
# The VA doubles as the secret iPaymu signs callbacks with, so treat it as a credential even
# though it is visible to buyers.
IPAYMU_VA=<iPaymu VA number>
IPAYMU_API_KEY=<iPaymu API key>
# false uses sandbox.ipaymu.com; true uses my.ipaymu.com and requires a registered static IP
# and domain on the merchant account (docs.ipaymu.com -> IP & Domain Validation).
IPAYMU_IS_PRODUCTION=false
# MERCHANT: the buyer pays exactly the listed price and the fee comes out of settlement.
# BUYER: the fee is added on top of the price, which the pricing page does not disclose.
IPAYMU_FEE_DIRECTION=MERCHANT
IPAYMU_EXPIRY_HOURS=24
# Callback (notifyUrl) to register on the merchant account:
#   https://geofold.sayba.id/api/payments/ipaymu/callback

# Midtrans, kept as the fallback gateway. Without MIDTRANS_SERVER_KEY its routes return 503.
# Server key is secret - never prefix NEXT_PUBLIC_. IS_PRODUCTION=false uses the Midtrans sandbox.
MIDTRANS_SERVER_KEY=<Midtrans server key>
MIDTRANS_IS_PRODUCTION=false

# Premium plan. These define what a customer is charged, how long they get, and how much storage
# they get - and every public page quotes them, so they must be right before launch.
PREMIUM_PRICE_IDR=35000
PREMIUM_DAYS=30
PREMIUM_STORAGE_GB=5
