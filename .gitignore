# Root ignore rules. `next/` and `mobile/` each carry their own .gitignore
# for framework-specific output; keep this file to cross-cutting concerns.

# Dependencies
node_modules/

# Build output
.next/
out/
dist/
build/
web-build/
*.tsbuildinfo

# Expo / native build caches
.expo/
.gradle/
.kotlin/
.cxx/
local.properties

# Test / coverage
coverage/

# IDEs
.vs/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Env & secrets — .env.example stays committed as the template
.env
.env.*
*.env
!.env.example
secrets.json
# Zipped env/secret bundles — never commit these
*.zip

# Claude local (personal) settings — shared .claude/settings.json stays committed
.claude/settings.local.json

# Local scratch scripts
next/_seed.mjs
next/_test.mjs

# Binaries & APKs
*.apk
