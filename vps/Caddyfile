api.geofold.sayba.id {
	# Compression: zstd preferred, gzip fallback (explicit — not a Caddy default)
	encode zstd gzip

	# --- Flat picture files: /api/pictures/view/<uuid>.webp ---
	# Content-addressed (UUID filename, never overwritten) => safe to cache
	# immutably for a year. Served straight off disk, Node not involved.
	@picturesFlat path_regexp flat ^/api/pictures/view/[^/]+\.webp$
	handle @picturesFlat {
		uri strip_prefix /api/pictures/view
		root * /home/deploy/app/storage/pictures
		file_server
		header {
			Cache-Control "public, max-age=31536000, immutable"
			Vary "Accept-Encoding"
		}
	}

	# Nested paths (/api/pictures/view/<user>/<survey>/<photo>.webp) are survey photos and are
	# deliberately NOT served from disk here: they are only reachable through /api/storage/*,
	# which requires a signed, expiring URL. A public file_server route for them was a way round
	# that check. They now fall through to the backend, which has no such route (404).

	# --- Storage API view (path-based, user-controllable) => revalidate ---
	@storageview path /api/storage/view*
	handle @storageview {
		reverse_proxy backend:3000 {
			health_uri /health
			health_interval 10s
			health_timeout 3s
			health_status 200
		}
		header Cache-Control "private, max-age=60, must-revalidate"
	}

	# --- Everything else -> backend ---
	handle {
		reverse_proxy backend:3000 {
			health_uri /health
			health_interval 10s
			health_timeout 3s
			health_status 200
		}
	}

	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# JSON access log to stdout (Docker rotates via json-file driver)
	log {
		output stdout
		format json
	}
}