{
  "expo": {
    "name": "GeoFold",
    "slug": "geofold",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "geofold",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.geofold.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.geofold.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E3EDE7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "com.android.vending.BILLING"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2C5A46",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "GeoFold records where each survey was taken, so a point can be found again on the ground."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "GeoFold uses the camera to photograph the survey point.",
          "photosPermission": "GeoFold can attach a photo you already took to a survey."
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-media-library",
        {
          "photosPermission": "GeoFold can attach a photo you already took to a survey.",
          "savePhotosPermission": "GeoFold saves a copy of each drone photo to your gallery so it stays on the phone.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "18bbc6b5-7e38-4ac4-b8c4-41995b5d4072"
      }
    },
    "owner": "majesticp"
  }
}
